MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_APP_USERNAME=memesee_app
MYSQL_APP_PASSWORD=replace-with-a-long-random-app-password
MYSQL_HOST_PORT=3307
MYSQL_IMAGE=mysql:8.4

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_HOST_PORT=6379
REDIS_IMAGE=redis:7.4

RABBITMQ_DEFAULT_USER=memesee
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-rabbitmq-password
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_IMAGE=rabbitmq:4.1-management

MINIO_ROOT_USER=replace-with-a-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z

MEILI_MASTER_KEY=replace-with-a-long-random-meilisearch-key
MEILI_HOST_PORT=7700
MEILISEARCH_IMAGE=getmeili/meilisearch:v1.12

APP_SECURITY_JWT_SECRET=replace-with-a-long-random-shared-jwt-secret-at-least-32-chars
APP_SECURITY_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-service-token
APP_SECURITY_JWT_EXPIRATION_SECONDS=86400

USER_DB_POOL_MAX_SIZE=10
USER_DB_POOL_MIN_IDLE=2
USER_DB_POOL_CONNECTION_TIMEOUT_MS=3000
USER_DB_POOL_VALIDATION_TIMEOUT_MS=1000
USER_DB_POOL_IDLE_TIMEOUT_MS=600000
USER_DB_POOL_MAX_LIFETIME_MS=1800000
USER_SHUTDOWN_TIMEOUT=20s

CONTENT_DB_POOL_MAX_SIZE=20
CONTENT_DB_POOL_MIN_IDLE=5
CONTENT_DB_POOL_CONNECTION_TIMEOUT_MS=3000
CONTENT_DB_POOL_VALIDATION_TIMEOUT_MS=1000
CONTENT_DB_POOL_IDLE_TIMEOUT_MS=600000
CONTENT_DB_POOL_MAX_LIFETIME_MS=1800000
CONTENT_SHUTDOWN_TIMEOUT=20s
CONTENT_PROJECTION_QUERY_SLOW_THRESHOLD=250ms

BACKEND_BUILD_IMAGE=maven:3.9.9-eclipse-temurin-21
BACKEND_RUNTIME_IMAGE=eclipse-temurin:21-jre
FRONTEND_NODE_IMAGE=node:22-alpine
FRONTEND_NGINX_IMAGE=nginx:1.27-alpine
MEDIA_WORKER_NODE_IMAGE=node:22-bookworm-slim

GATEWAY_HTTPCLIENT_CONNECT_TIMEOUT_MS=3000
GATEWAY_HTTPCLIENT_RESPONSE_TIMEOUT=30s
GATEWAY_RETRY_RETRIES=1
GATEWAY_RETRY_FIRST_BACKOFF=50ms
GATEWAY_RETRY_MAX_BACKOFF=250ms
GATEWAY_RETRY_BACKOFF_FACTOR=2
GATEWAY_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=50
GATEWAY_CIRCUIT_BREAKER_MINIMUM_CALLS=10
GATEWAY_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
GATEWAY_CIRCUIT_BREAKER_OPEN_STATE_WAIT=10s
GATEWAY_CIRCUIT_BREAKER_HALF_OPEN_CALLS=5
GATEWAY_CIRCUIT_BREAKER_TIMEOUT=5s
GATEWAY_SHUTDOWN_TIMEOUT=20s

CONTENT_MEDIA_PROCESSING_ASYNC_ENABLED=true
CONTENT_MEDIA_MINIO_BUCKET=memesee-post-images
CONTENT_MEDIA_DIRECT_DELIVERY_ENABLED=true
CONTENT_MEDIA_PUBLIC_BASE_URL=https://memesee.world/media
CONTENT_MEDIA_MAX_BYTES=20971520
CONTENT_OUTBOX_PROCESSOR_DISTRIBUTED_LOCK_ENABLED=true
MEDIA_WORKER_CONCURRENCY=2
MEDIA_WORKER_DB_POOL=5
MEDIA_WORKER_HEALTH_PORT=8088

FRONTEND_ORIGIN=https://memesee.world
VITE_API_BASE=
FRONTEND_HOST_PORT=3000
GATEWAY_HOST_PORT=8080
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.128.0
OTEL_COLLECTOR_OTLP_GRPC_HOST_PORT=4317
OTEL_COLLECTOR_OTLP_HTTP_HOST_PORT=4318
MANAGEMENT_TRACING_ENABLED=true
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
COMPOSE_CONTAINER_PREFIX=memesee
MEMESEE_IMAGE_REGISTRY=ghcr.io/douziao
MEMESEE_VERSION=v0.1.0

DEPLOY_VERIFY_PRODUCTION_RUNTIME=true
DEPLOY_AUDIT_FILE=
DEPLOY_LAUNCH_AUDIT_FILE=
DEPLOY_VERIFY_API_LATENCY=true
DEPLOY_VERIFY_API_LATENCY_ITERATIONS=50
DEPLOY_VERIFY_API_MAX_P95_MS=500
DEPLOY_VERIFY_API_MAX_ERROR_RATE_PERCENT=0
DEPLOY_VERIFY_METRIC_SCRAPE_WAIT_SECONDS=20
DEPLOY_VERIFY_CACHE_METRICS=false
DEPLOY_VERIFY_CONTENT_COMMAND_METRIC_DEFINITIONS=true
DEPLOY_VERIFY_CONTENT_COMMAND_METRICS=false
DEPLOY_VERIFY_INTERNAL_ADMIN_METRIC_DEFINITIONS=true
DEPLOY_VERIFY_INTERNAL_ADMIN_METRICS=false
DEPLOY_VERIFY_OTEL_COLLECTOR_METRICS=true
DEPLOY_VERIFY_SHARE_HTML_METRICS=false
DEPLOY_VERIFY_SHARE_HTML_BASE_URL=http://127.0.0.1:8080
# Comma-separated paths are supported after production has real public posts.
DEPLOY_VERIFY_SHARE_HTML_PATH=/share/posts/1
DEPLOY_VERIFY_SHARE_HTML_OUTER_ROUTE=false
DEPLOY_VERIFY_SHARE_HTML_OUTER_BASE_URL=http://127.0.0.1
# Comma-separated paths are supported after production has real public posts.
DEPLOY_VERIFY_SHARE_HTML_OUTER_PATH=/posts/1
DEPLOY_VERIFY_SHARE_HTML_HOST=
DEPLOY_VERIFY_HTTPS_REDIRECT=false
DEPLOY_VERIFY_HTTPS_REDIRECT_BASE_URL=http://127.0.0.1
# Comma-separated paths are supported after HTTPS is enabled.
DEPLOY_VERIFY_HTTPS_REDIRECT_PATH=/posts/1
DEPLOY_VERIFY_HTTPS_REDIRECT_HOST=memesee.world
DEPLOY_VERIFY_HSTS=false
DEPLOY_VERIFY_HSTS_BASE_URL=https://memesee.world
# Comma-separated paths are supported after HTTPS is enabled.
DEPLOY_VERIFY_HSTS_PATH=/
DEPLOY_VERIFY_HSTS_HOST=memesee.world
DEPLOY_VERIFY_HSTS_SKIP_CERTIFICATE_CHECK=false
DEPLOY_VERIFY_MIN_CACHE_HIT_RATE_PERCENT=60
DEPLOY_VERIFY_MEDIA_URL=

DEPLOY_POST_LAUNCH_WINDOW_MINUTES=0,5,15,60
DEPLOY_POST_LAUNCH_INSPECT_DLQ=false
