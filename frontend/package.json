{
  "name": "memesee-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "audit": "npm audit",
    "verify:metadata": "node scripts/check-built-index-metadata.mjs",
    "verify:routes": "node scripts/check-production-routes.mjs",
    "verify:render": "node scripts/check-production-render.mjs",
    "perf:bundle": "node scripts/check-bundle-budget.mjs",
    "quality": "npm run audit && npm run test && npm run build && npm run verify:metadata && npm run verify:routes && npm run verify:render && npm run perf:bundle"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.10.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
